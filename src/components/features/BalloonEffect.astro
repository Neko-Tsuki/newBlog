---
// 生日气球：生日当天飘一轮气球，当天只播一次。配置见 profileConfig.birthday。
// 判定必须在客户端做 —— 静态站点构建期拿到的是构建机时间（部署平台多为 UTC）。
---

<script>
	import { profileConfig, siteConfig } from "@/config";

	// 运动参数。一轮总时长 = SPAWN_WINDOW_MS + RISE_MS + TAIL_FADE_MS ≈ 4.9 秒
	const BALLOON_COUNT = 36;
	const SPAWN_WINDOW_MS = 1100; // 错峰入场铺开的总时长
	const RISE_MS = 3400; // 单个气球从底部升到顶部之外所需时间
	const TAIL_FADE_MS = 400; // 最后一个气球离场后整层淡出的时长
	const SWAY_PX = 46;
	const Z_INDEX = 100; // 与樱花同层；pointer-events:none，不挡操作
	const STORAGE_KEY = "birthdayBalloonShown";

	const PALETTE = [
		"#ff6b81",
		"#ffa502",
		"#ffd93d",
		"#6bcB77",
		"#4d96ff",
		"#9b6bff",
		"#ff8fab",
		"#38c7c7",
	];

	type Balloon = {
		xRatio: number; // 水平基准位置（0-1）
		spawnAt: number; // 入场延迟（毫秒）
		sway: number; // 水平摇摆幅度
		swayPhase: number;
		swaySpeed: number;
		tilt: number; // 倾斜角（弧度）
		tiltSpeed: number;
		scale: number;
		color: string;
		highlightOnLeft: boolean;
	};

	/** 站点时区的今天。返回 null 表示时区名非法（配置写错时不让特效炸掉） */
	function todayInSiteTimezone(): { md: string; ymd: string } | null {
		try {
			// en-CA 的日期格式恰好是 YYYY-MM-DD，取后 5 位就是 MM-DD
			const ymd = new Intl.DateTimeFormat("en-CA", {
				timeZone: siteConfig.timezone || "UTC",
				year: "numeric",
				month: "2-digit",
				day: "2-digit",
			}).format(new Date());
			return { md: ymd.slice(5), ymd };
		} catch {
			console.warn("[Balloon] siteConfig.timezone 不是合法时区名，跳过生日特效");
			return null;
		}
	}

	/** 配置值容忍 "MM-DD" 与 "YYYY-MM-DD" 两种写法，避免写错格式就静默失效 */
	function normalizeBirthday(raw: string | undefined): string {
		const value = (raw ?? "").trim();
		if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value.slice(5);
		return /^\d{2}-\d{2}$/.test(value) ? value : "";
	}

	/** localStorage 在无痕模式/禁用存储时会抛异常，读写都必须包住 */
	function readShownDate(): string | null {
		try {
			return localStorage.getItem(STORAGE_KEY);
		} catch {
			return null;
		}
	}

	function markShown(date: string): void {
		try {
			localStorage.setItem(STORAGE_KEY, date);
		} catch {
			// 存不下不影响动画
		}
	}

	function prefersReducedMotion(): boolean {
		return (
			typeof window.matchMedia === "function" &&
			window.matchMedia("(prefers-reduced-motion: reduce)").matches
		);
	}

	function randomBetween(min: number, max: number): number {
		return min + Math.random() * (max - min);
	}

	class BalloonManager {
		private canvas: HTMLCanvasElement | null = null;
		private ctx: CanvasRenderingContext2D | null = null;
		private balloons: Balloon[] = [];
		private rafId = 0;
		private startTime = 0;
		private width = 0;
		private height = 0;
		private paused = false;
		private pausedAt = 0;
		private isRunning = false;

		private reducedMotionQuery: MediaQueryList | null = null;

		get getIsRunning(): boolean {
			return this.isRunning;
		}

		init(): void {
			if (this.isRunning) return;

			this.width = window.innerWidth;
			this.height = window.innerHeight;

			this.canvas = document.createElement("canvas");
			this.canvas.setAttribute("id", "canvas_balloon");
			this.canvas.setAttribute(
				"style",
				`position: fixed; left: 0; top: 0; pointer-events: none; z-index: ${Z_INDEX}; transform: translateZ(0);`,
			);
			this.canvas.setAttribute("aria-hidden", "true");
			document.body.appendChild(this.canvas);

			this.ctx = this.canvas.getContext("2d");
			if (!this.ctx) {
				// 拿不到 2D 上下文就干净退出，不留半截 canvas
				this.canvas.remove();
				this.canvas = null;
				return;
			}

			this.applySize();
			this.balloons = this.createBalloons();

			this.boundHandleResize = this.handleResize.bind(this);
			this.boundHandleVisibility = this.handleVisibility.bind(this);
			this.boundHandleMotionChange = this.handleMotionChange.bind(this);

			window.addEventListener("resize", this.boundHandleResize);
			document.addEventListener("visibilitychange", this.boundHandleVisibility);
			if (typeof window.matchMedia === "function") {
				this.reducedMotionQuery = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				);
				this.reducedMotionQuery.addEventListener?.(
					"change",
					this.boundHandleMotionChange,
				);
			}

			this.isRunning = true;
			this.startTime = performance.now();
			this.rafId = requestAnimationFrame(this.tick);
		}

		stop(): void {
			if (this.rafId) {
				cancelAnimationFrame(this.rafId);
				this.rafId = 0;
			}
			window.removeEventListener("resize", this.boundHandleResize);
			document.removeEventListener("visibilitychange", this.boundHandleVisibility);
			this.reducedMotionQuery?.removeEventListener?.(
				"change",
				this.boundHandleMotionChange,
			);
			this.reducedMotionQuery = null;

			this.canvas?.remove();
			this.canvas = null;
			this.ctx = null;
			this.balloons = [];
			this.isRunning = false;
		}

		private boundHandleResize: () => void = () => {};
		private boundHandleVisibility: () => void = () => {};
		private boundHandleMotionChange: () => void = () => {};

		/** 按 devicePixelRatio 设置 backing store，气球边缘才不糊；上限 2 避免 4K 上白烧 GPU */
		private applySize(): void {
			if (!this.canvas || !this.ctx) return;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			this.canvas.width = Math.floor(this.width * dpr);
			this.canvas.height = Math.floor(this.height * dpr);
			this.canvas.style.width = `${this.width}px`;
			this.canvas.style.height = `${this.height}px`;
			this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		}

		private handleResize(): void {
			this.width = window.innerWidth;
			this.height = window.innerHeight;
			this.applySize(); // 位置都用比例存，改完尺寸不用重算气球
		}

		/** 标签页切到后台时停表，回来再把时间轴整体后移，避免回来一次性快进 */
		private handleVisibility(): void {
			if (document.hidden) {
				this.paused = true;
				this.pausedAt = performance.now();
			} else if (this.paused) {
				this.startTime += performance.now() - this.pausedAt;
				this.paused = false;
			}
		}

		/** 播放途中有用户把系统切成「减少动态效果」，立刻收摊 */
		private handleMotionChange(): void {
			if (this.reducedMotionQuery?.matches) this.stop();
		}

		private createBalloons(): Balloon[] {
			return Array.from({ length: BALLOON_COUNT }, () => ({
				xRatio: Math.random(),
				spawnAt: Math.random() * SPAWN_WINDOW_MS,
				sway: randomBetween(SWAY_PX * 0.4, SWAY_PX),
				swayPhase: Math.random() * Math.PI * 2,
				swaySpeed: randomBetween(0.6, 1.3),
				tilt: randomBetween(-0.18, 0.18),
				tiltSpeed: randomBetween(-0.5, 0.5),
				scale: randomBetween(0.7, 1.25),
				color: PALETTE[Math.floor(Math.random() * PALETTE.length)],
				highlightOnLeft: Math.random() < 0.5,
			}));
		}

		private tick = (now: number): void => {
			if (!this.isRunning) return;
			if (this.paused) {
				this.rafId = requestAnimationFrame(this.tick);
				return;
			}

			this.draw(now - this.startTime);
			this.rafId = requestAnimationFrame(this.tick);
		};

		private draw(elapsed: number): void {
			const ctx = this.ctx;
			if (!ctx) return;

			const totalMs = SPAWN_WINDOW_MS + RISE_MS + TAIL_FADE_MS;
			if (elapsed >= totalMs) {
				this.stop();
				return;
			}

			// 末尾整体淡出，不让最后几个气球"啪"地消失
			const tail = elapsed - (SPAWN_WINDOW_MS + RISE_MS);
			const layerAlpha = tail > 0 ? Math.max(0, 1 - tail / TAIL_FADE_MS) : 1;

			ctx.clearRect(0, 0, this.width, this.height);
			ctx.globalAlpha = layerAlpha;

			for (const balloon of this.balloons) {
				const progress = (elapsed - balloon.spawnAt) / RISE_MS;
				if (progress <= 0 || progress >= 1) continue;
				this.drawBalloon(ctx, balloon, progress);
			}

			ctx.globalAlpha = 1;
		}

		private drawBalloon(
			ctx: CanvasRenderingContext2D,
			balloon: Balloon,
			progress: number,
		): void {
			const radius = 22 * balloon.scale;
			const bodyHeight = radius * 2.5;

			const baseX = balloon.xRatio * this.width;
			const x =
				baseX +
				Math.sin(progress * Math.PI * 3 * balloon.swaySpeed + balloon.swayPhase) *
					balloon.sway;
			// 从屏幕下方一个身位升到上方一个身位
			const y = this.height + bodyHeight - progress * (this.height + bodyHeight * 2);

			// 出场和离场各淡一下
			const alpha = Math.min(1, progress / 0.08, (1 - progress) / 0.12);
			if (alpha <= 0) return;

			ctx.save();
			ctx.globalAlpha *= alpha;
			ctx.translate(x, y);
			ctx.rotate(balloon.tilt + progress * balloon.tiltSpeed);
			this.drawBalloonShape(ctx, radius, bodyHeight, balloon);
			ctx.restore();
		}

		private drawBalloonShape(
			ctx: CanvasRenderingContext2D,
			radius: number,
			bodyHeight: number,
			balloon: Balloon,
		): void {
			// 线：从气球底部结点往下垂一小段，末端轻微摆
			ctx.strokeStyle = "rgba(255, 255, 255, 0.55)";
			ctx.lineWidth = 1.2;
			ctx.beginPath();
			ctx.moveTo(0, bodyHeight / 2 + radius * 0.35);
			ctx.quadraticCurveTo(
				radius * 0.5,
				bodyHeight / 2 + radius * 1.6,
				radius * 0.15,
				bodyHeight / 2 + radius * 2.6,
			);
			ctx.stroke();

			ctx.fillStyle = balloon.color;
			ctx.beginPath();
			ctx.ellipse(0, 0, radius, bodyHeight / 2, 0, 0, Math.PI * 2);
			ctx.fill();

			// 底部小三角结
			ctx.beginPath();
			ctx.moveTo(-radius * 0.22, bodyHeight / 2 - radius * 0.1);
			ctx.lineTo(radius * 0.22, bodyHeight / 2 - radius * 0.1);
			ctx.lineTo(0, bodyHeight / 2 + radius * 0.34);
			ctx.closePath();
			ctx.fill();

			// 高光：让气球有"鼓起来"的立体感
			ctx.fillStyle = "rgba(255, 255, 255, 0.38)";
			ctx.beginPath();
			ctx.ellipse(
				balloon.highlightOnLeft ? -radius * 0.34 : radius * 0.34,
				-bodyHeight * 0.16,
				radius * 0.24,
				bodyHeight * 0.16,
				balloon.highlightOnLeft ? -0.5 : 0.5,
				0,
				Math.PI * 2,
			);
			ctx.fill();
		}
	}

	(function setupBalloon() {
		if (window.balloonInitialized) return;
		window.balloonInitialized = true;

		const birthday = normalizeBirthday(profileConfig.birthday);
		if (!birthday) return; // 没配生日 = 关闭

		// 动画正是「减少动态效果」要避开的，静默跳过
		if (prefersReducedMotion()) return;

		const today = todayInSiteTimezone();
		if (!today || today.md !== birthday) return;

		// 当天只播一次，重开浏览器也不再播；先记上再播，刷新不至于重播
		if (readShownDate() === today.ymd) return;
		markShown(today.ymd);

		const manager = new BalloonManager();
		window.balloonManager = manager;
		manager.init();
	})();
</script>
