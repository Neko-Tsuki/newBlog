---
import { Icon } from "astro-icon/components";

interface Props {
	icon: string;
	title: string;
	subtitle: string;
	href: string;
}

const { icon, title, subtitle, href } = Astro.props;
const isMail = href.startsWith("mailto:");
---

<a
	href={href}
	target={isMail ? undefined : "_blank"}
	rel={isMail ? undefined : "noopener noreferrer"}
	class="group flex items-center gap-4 no-underline rounded-(--radius-large) p-4
	       bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) active:bg-(--btn-regular-bg-active)
	       transition-all duration-300 hover:-translate-y-1 active:scale-[0.98]"
>
	<span
		class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center
		       bg-(--card-bg) text-(--primary) border border-(--line-divider)
		       transition-transform duration-300 group-hover:scale-110"
	>
		<Icon name={icon} class="text-[1.5rem]" />
	</span>
	<span class="min-w-0">
		<span class="block font-bold text-(--deep-text)">{title}</span>
		<span class="block text-sm text-(--content-meta) truncate">{subtitle}</span>
	</span>
</a>
